# ---------- Astron settings ----------
# These are the starting values. Once the site is running, the admin can change
# most of them on the Settings page, which overrides anything here.
# Keep this file private: it can hold your AI key.

PORT=3000
DATA_DIR=/var/lib/astron

# What the site is called
SITE_NAME=Astron

# Your course: years, subjects, labs and syllabus. See docs/CATALOG.md.
# Leave blank to use the small example course in config/catalog.example.json.
CATALOG=

# First run only: creates the admin account. You'll change the password on first sign-in.
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_PASSWORD=

# ---------- AI ----------
# Any provider. The format is worked out from the address unless you set AI_FORMAT.
#
#   OpenAI            https://api.openai.com/v1
#   Azure OpenAI      https://YOUR-RESOURCE.openai.azure.com/openai/v1   (model = deployment name)
#   Azure, older      https://YOUR-RESOURCE.openai.azure.com             + AI_FORMAT=azure
#   Anthropic         https://api.anthropic.com
#   Google Gemini     https://generativelanguage.googleapis.com
#   DeepSeek          https://api.deepseek.com/v1
#   Groq              https://api.groq.com/openai/v1
#   Mistral           https://api.mistral.ai/v1
#   OpenRouter        https://openrouter.ai/api/v1
#   Together          https://api.together.xyz/v1
#   Ollama, local     http://127.0.0.1:11434/v1
#
# Typing up photographed pages needs a model that can read images.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_FORMAT=auto
AI_API_VERSION=2024-10-21
# Requests per friend per day. The admin has no limit.
AI_DAILY_LIMIT=40

# ---------- Reading handwriting ----------
# azure     Azure AI Document Intelligence (recommended: it reads handwriting well)
# ai        send page images to your own model, if it can read images
# tesseract free and local; fine for printed text, weak on handwriting
#           (sudo apt-get install -y tesseract-ocr)
# off       only typed PDFs are readable by the AI
OCR_ENGINE=azure
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_API_VERSION=2024-11-30
# Note: on the free F0 tier only the first 2 pages of a PDF are read. Use S0 for real notes.

# ---------- Storage ----------
STORAGE_LIMIT_MB=5120
MAX_FILE_MB=25

# Set to true if the site is served over HTTPS
COOKIE_SECURE=false
